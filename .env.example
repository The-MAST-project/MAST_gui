# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS are derived from the bootstrap config's
# `controller_host` + `domain`, so normally leave both unset. Set them only to add
# something the derivation cannot know -- an IP the box is browsed by, say.
# ALLOWED_HOSTS=localhost,127.0.0.1,mast-ns-control,mast-ns-control.weizmann.ac.il
# CSRF_TRUSTED_ORIGINS=https://mast-ns-control.weizmann.ac.il,https://10.23.1.181

# MAST Configuration
MAST_SITE=ns
MAST_CONFIG_SOURCE=

# Social Auth (configure if using)
# Google OAuth2
# SOCIALACCOUNT_PROVIDERS_GOOGLE_CLIENT_ID=
# SOCIALACCOUNT_PROVIDERS_GOOGLE_SECRET=

# Facebook
# SOCIALACCOUNT_PROVIDERS_FACEBOOK_CLIENT_ID=
# SOCIALACCOUNT_PROVIDERS_FACEBOOK_SECRET=

# Apple
# SOCIALACCOUNT_PROVIDERS_APPLE_CLIENT_ID=
# SOCIALACCOUNT_PROVIDERS_APPLE_SECRET=
